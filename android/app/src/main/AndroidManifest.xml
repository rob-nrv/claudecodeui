<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets us call Termux's RunCommandService. Granted by the user via
         Settings > Apps > CloudCLI Runtime > Permissions once Termux is
         installed; requesting it before that is a no-op, not a crash. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- The one HTTP call this app makes is to 127.0.0.1 on the device itself
         (the cosmetic health poll in TermuxRuntimeAdapter) — never a remote host. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ (targetSdk >= 30) hides other apps' packages by default.
         Without this, PackageManager cannot see Termux to check it is
         installed, and the explicit Intent to RunCommandService silently
         fails to resolve. -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.CloudCliRuntimeController">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <!-- Not exported: only this app's own PendingIntent may deliver a
             RUN_COMMAND result here, never an arbitrary broadcast. -->
        <receiver
            android:name=".TermuxResultReceiver"
            android:exported="false" />

    </application>
</manifest>
