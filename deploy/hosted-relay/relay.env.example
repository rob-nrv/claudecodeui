# /etc/cloudcli-relay/relay.env  (root:cloudcli-relay 0640). No secrets live here:
# accounts, keys and sessions are in the relay database.
DATABASE_PATH=/var/lib/cloudcli-relay/relay.db
SERVER_PORT=3001
CLOUDCLI_REMOTE_GATEWAY=external-tls
CLOUDCLI_REMOTE_ORIGIN=https://RELAY_DOMAIN
CLOUDCLI_REMOTE_PORT=3443
# AGPL-3.0 section 13: public https URL of the Corresponding Source of THIS modified version.
CLOUDCLI_SOURCE_URL=https://SOURCE_REPO_URL
NODE_ENV=production
