# /srv/cloudcli-relay/relay.env (mode 0600, outside the repository). Values are examples only.
RELAY_IMAGE=cloudcli-relay:nas
RELAY_NETWORK_MODE=service:tailscale
# Copy the exact name from `tailscale status` / the Tailscale admin console after the node exists:
CLOUDCLI_REMOTE_ORIGIN=https://<node>.<tailnet>.ts.net
CLOUDCLI_SOURCE_URL=https://<public-source-url-of-the-deployed-commit>
TS_HOSTNAME=cloudcli-relay
TS_SERVE_FILE=serve-tailnet.json
# First start only, then remove the line: TS_AUTHKEY=<one-time, tagged, non-reusable auth key>
